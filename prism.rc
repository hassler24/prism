1 ICON "assets\\prism.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hassler"
            VALUE "FileDescription", "Prism - instant file finder"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "prism"
            VALUE "OriginalFilename", "prism.exe"
            VALUE "ProductName", "Prism"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
